# ==============================================================================
# Git Ignore Configuration - Hotel Reservation Risk Intelligence Monorepo
# ==============================================================================

# Python bytecode & environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.log
*.sqlite3

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node.js & Next.js Build Artifacts
node_modules/
.next/
out/
build/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Linting Caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Raw Large Dataset & Intermediate Training Splits (Keep Metadata & Samples Tracked)
data/raw/*.csv
data/processed/*.parquet
data/processed/*.csv
!data/processed/feature_metadata.json
!data/sample/*.csv
data/outputs/prediction_logs.csv
!data/outputs/.gitkeep

# Model Artifacts (Ignore arbitrary/temporary cbm models, but KEEP Champion Model)
*.cbm
!backend/app/ml/models/champion/catboost_model.cbm
!backend/app/ml/models/champion/model_metadata.json
